# Live drafting is disabled and killed by default. Adding a key is not enough:
# an approved persistent distributed usage guard must be wired by the operator.
QUOTEPROOF_LIVE_DRAFT_ENABLED=false
QUOTEPROOF_LIVE_DRAFT_KILL_SWITCH=true
QUOTEPROOF_PROFILE=production
QUOTEPROOF_ALLOWED_ORIGINS=https://quoteproof-demo.wernhervonschrader.chatgpt.site

# Required only for a separately authorized server-side live deployment.
# Never expose this in a browser or regular CI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Disposable access code for a separately authorized live endpoint.
# Use at least 24 random characters and store it only in server-side secrets.
QUOTEPROOF_DEMO_KEY=
